# NVIDIA NIM (LLM)
NVIDIA_API_KEY=your-nvapi-key-here
NIM_MODEL=google/gemma-4-31b-it

# STT (faster-whisper 로컬 — NIM HTTP ASR 미지원)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
STT_LANGUAGE=ko

# TTS (향기 추천 AI 대사 → 스피커)
# python3 -m pip install --user edge-tts
TTS_VOICE=ko-KR-SunHiNeural
TTS_RATE=-8%
TTS_LANGUAGE=ko
