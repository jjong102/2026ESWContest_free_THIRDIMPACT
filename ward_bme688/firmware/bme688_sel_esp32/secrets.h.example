// Copy this file to "secrets.h" and fill in your own values.
// secrets.h is git-ignored so your credentials never get committed.
#pragma once

// ---- WiFi hotspot (classic ESP32 Feather is 2.4 GHz only) ----
#define SECRET_WIFI_SSID   "YOUR_WIFI_SSID"
#define SECRET_WIFI_PASS   "YOUR_WIFI_PASSWORD"

// ---- HiveMQ Cloud (MQTT over TLS, port 8883) ----
#define SECRET_MQTT_BROKER "your-cluster-id.s1.eu.hivemq.cloud"
#define SECRET_MQTT_USER   "YOUR_MQTT_USERNAME"
#define SECRET_MQTT_PASS   "YOUR_MQTT_PASSWORD"
